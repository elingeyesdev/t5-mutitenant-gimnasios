# Copiar este archivo como .env y reemplazar los valores de ejemplo.
# Nunca subir .env al repositorio.

# SQL Server externo (host de VirtualBox NAT).
# La direccion 10.0.2.2 corresponde a nuestro laboratorio.
SQL_CONNECTION_STRING='Server=10.0.2.2,1433;Database=GestionGimnasios;User Id=sa;Password=CAMBIAR_CONTRASENA;Encrypt=True;TrustServerCertificate=True'

# Generar una clave JWT aleatoria de al menos 32 caracteres.
JWT_CLAVE='CAMBIAR_POR_CLAVE_ALEATORIA_SEGURA'
