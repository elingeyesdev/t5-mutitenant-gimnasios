@model SuscripcionForm
@inject GestionGimnasios.Web.Infrastructure.UsuarioActual Actual
@{
    ViewData["Title"] = "Nueva suscripción";
    ViewData["Pretitulo"] = "Suscripciones";
    var socios = (List<ClienteResumenDto>)ViewBag.Socios;
    var planes = (List<PlanDto>)ViewBag.Planes;
    var sucursales = (List<SucursalDto>)ViewBag.Sucursales;
    var usuario = ViewBag.Usuario as UsuarioDto;
}
<div class="row row-cards">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><h3 class="card-title">1. Socio</h3></div>
            <div class="card-body">
                @if (usuario is not null)
                {
                    <div class="d-flex align-items-center mb-3">
                        <span class="avatar me-2 bg-blue-lt">@usuario.NombreCompleto[..1]</span>
                        <div><div class="fw-medium">@usuario.NombreCompleto</div><div class="text-secondary small">@usuario.Email · CI @usuario.Perfil?.Ci</div></div>
                        <a class="ms-auto btn btn-sm btn-link" asp-action="Nueva">Cambiar</a>
                    </div>
                }
                else
                {
                    <form method="get" class="input-group mb-2">
                        <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Nombre, correo o CI del socio" />
                        <button class="btn btn-primary"><i class="ti ti-search"></i></button>
                    </form>
                    @foreach (var s in socios)
                    {
                        <a class="list-group-item list-group-item-action d-flex" asp-action="Nueva" asp-route-usuarioId="@s.Id"><span>@s.NombreCompleto</span><span class="ms-auto text-secondary small">CI @s.Ci</span></a>
                    }
                    <div class="text-secondary small mt-2">¿No está registrado? <a asp-controller="Usuarios" asp-action="Crear">Registrar socio</a></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <form method="post" asp-action="Nueva" class="card">
            <div class="card-header"><h3 class="card-title">2. Plan y pago</h3></div>
            <div class="card-body">
                <input type="hidden" asp-for="UsuarioId" />
                <div class="mb-3">
                    <label class="form-label required">Plan</label>
                    <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column">
                        @foreach (var p in planes)
                        {
                            <label class="form-selectgroup-item flex-fill">
                                <input type="radio" name="PlanId" value="@p.Id" class="form-selectgroup-input" required />
                                <div class="form-selectgroup-label d-flex align-items-center p-3">
                                    <div class="me-3"><span class="form-selectgroup-check"></span></div>
                                    <div class="flex-fill">
                                        <div class="fw-medium">@p.Nombre <span class="text-secondary small">@(p.Cadena ?? "Global")</span></div>
                                        <div class="text-secondary small">@string.Join(" · ", p.Beneficios)</div>
                                    </div>
                                    <div class="fw-bold">Bs @p.PrecioMensual.ToString("0.00")</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Sucursal principal</label>
                        <select asp-for="SucursalPrincipalId" class="form-select" disabled="@(Actual.SucursalFiltro is not null)">
                            @foreach (var s in sucursales)
                            {
                                <option value="@s.Id">@s.Nombre</option>
                            }
                        </select>
                        @if (Actual.SucursalFiltro is not null)
                        {
                            <input type="hidden" asp-for="SucursalPrincipalId" />
                        }
                    </div>
                    <div class="col-md-3"><label class="form-label">Inicio</label><input asp-for="Inicio" type="date" class="form-control" /></div>
                    <div class="col-md-3"><label class="form-label">Meses</label><input asp-for="Meses" type="number" min="1" max="24" class="form-control" /></div>
                    <div class="col-md-4"><label class="form-label">Monto pagado (Bs)</label><input asp-for="MontoPagado" type="number" step="0.01" min="0" class="form-control" /></div>
                    <div class="col-md-4">
                        <label class="form-label">Método</label>
                        <select asp-for="Metodo" class="form-select"><option>EFECTIVO</option><option>TRANSFERENCIA</option><option>QR</option><option>TARJETA</option></select>
                    </div>
                    <div class="col-md-4 pt-4"><label class="form-check"><input asp-for="RenovacionAutomatica" type="checkbox" class="form-check-input" /><span class="form-check-label">Renovación automática</span></label></div>
                </div>
            </div>
            <div class="card-footer"><button class="btn btn-primary" disabled="@(usuario is null)">Registrar suscripción</button></div>
        </form>
    </div>
</div>
