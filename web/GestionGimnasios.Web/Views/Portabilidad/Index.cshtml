@model List<ConsentimientoDto>
@{
    ViewData["Title"] = "Perfiles portables";
    ViewData["Pretitulo"] = "Gestión";
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Socios que autorizaron a tu cadena</h3>
        <div class="card-actions text-secondary">Solo se muestran los datos que cada socio eligió compartir</div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Socio</th><th>Datos compartidos</th><th>Autorizado el</th><th>Consultas</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Socio</td>
                    <td>
                        @foreach (var d in c.Datos)
                        {
                            <span class="badge bg-blue-lt me-1">@DatosPortables.Etiqueta(d)</span>
                        }
                    </td>
                    <td>@Reloj.ALocal(c.OtorgadoEn).ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-secondary">@c.Consultas</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Perfil" asp-route-id="@c.UsuarioId">Ver perfil</a></td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-secondary py-4">Ningún socio de otra cadena autorizó todavía a la tuya.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="text-secondary small mt-2">El socio da o revoca la autorización desde la app. Cada consulta queda registrada y el socio puede verla.</div>
