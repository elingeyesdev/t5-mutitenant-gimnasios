@model List<SucursalDto>
@{
    ViewData["Title"] = "Mapa de sucursales";
    ViewData["Pretitulo"] = "Gestión";
    var conUbicacion = Model.Where(x => x.Ubicacion is { } u && !(u.Latitud == 0 && u.Longitud == 0)).ToList();
    var sinUbicacion = Model.Count - conUbicacion.Count;
    var puntos = conUbicacion.Select(s => new
    {
        nombre = s.Nombre, cadena = s.Cadena, direccion = $"{s.Ubicacion!.Direccion}, {s.Ubicacion.Ciudad}",
        latitud = s.Ubicacion.Latitud, longitud = s.Ubicacion.Longitud, abierta = s.AbiertaAhora,
        editar = Url.Action("Editar", new { id = s.Id }),
    });
}
@section Estilos {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/js/mapa.js" asp-append-version="true"></script>
}
<p class="text-secondary">Haz clic en un marcador para ver la sucursal.@(sinUbicacion > 0 ? $" {sinUbicacion} sucursal(es) aún no tienen ubicación: edítalas para marcarla." : "")</p>
<div class="card mb-3">
    <div class="card-body p-2">
        <div class="mapa mapa-sucursales" data-mapa-sucursales="@System.Text.Json.JsonSerializer.Serialize(puntos)"></div>
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Sucursal</th><th>Cadena</th><th>Dirección</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in conUbicacion)
            {
                var u = s.Ubicacion!;
                <tr>
                    <td class="fw-medium">@s.Nombre</td>
                    <td class="text-secondary">@s.Cadena</td>
                    <td>@u.Direccion, @u.Ciudad</td>
                    <td>
                        @if (s.AbiertaAhora)
                        {
                            <span class="badge bg-green-lt">Abierta</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">Cerrada</span>
                        }
                    </td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@s.Id"><i class="ti ti-edit me-1"></i>Ver o editar</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
