@model SucursalForm
@inject GestionGimnasios.Web.Infrastructure.UsuarioActual Actual
@{
    var sucursal = ViewBag.Sucursal as SucursalDto;
    var editando = sucursal is not null;
    var cadenas = (List<CadenaDto>)ViewBag.Cadenas;
    ViewData["Title"] = editando ? sucursal!.Nombre : "Nueva sucursal";
    ViewData["Pretitulo"] = "Sucursales";
    var horarios = Model.Horarios ?? [];
    string[] nombres = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
@section Acciones {
    @if (editando && Actual.EsSuperAdmin)
    {
        <form method="post" asp-action="Eliminar" asp-route-id="@sucursal!.Id" data-confirmar="¿Eliminar la sucursal? Si tiene datos asociados conviene desactivarla.">
            <button class="btn btn-outline-danger"><i class="ti ti-trash me-1"></i>Eliminar</button>
        </form>
    }
}
<form method="post" asp-action="@(editando ? "Editar" : "Crear")" asp-route-id="@sucursal?.Id">
    <div class="row row-cards">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Datos</h3></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label required">Cadena</label>
                        @if (editando)
                        {
                            <input type="hidden" asp-for="CadenaId" />
                            <input class="form-control" value="@sucursal!.Cadena" disabled />
                        }
                        else
                        {
                            <select asp-for="CadenaId" class="form-select" required>
                                <option value="">Elegir…</option>
                                @foreach (var c in cadenas)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="mb-3"><label class="form-label required">Nombre</label><input asp-for="Nombre" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="2"></textarea></div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label required">Capacidad máxima</label><input asp-for="CapacidadMaxima" type="number" min="1" class="form-control" required /></div>
                        <div class="col-6">
                            <label class="form-label">Estado</label>
                            <label class="form-check form-switch mt-2"><input asp-for="Activa" class="form-check-input" type="checkbox" /><span class="form-check-label">Activa</span></label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">Ubicación</h3></div>
                <div class="card-body">
                    <div class="mb-3"><label class="form-label required">Dirección</label><input name="Ubicacion.Direccion" value="@Model.Ubicacion?.Direccion" class="form-control" required /></div>
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label required">Ciudad</label><input name="Ubicacion.Ciudad" value="@(Model.Ubicacion?.Ciudad ?? "Santa Cruz")" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label required">Latitud</label><input name="Ubicacion.Latitud" value="@Model.Ubicacion?.Latitud.ToString(inv)" class="form-control" required pattern="-?[0-9]+(\.[0-9]+)?" /></div>
                        <div class="col-md-4"><label class="form-label required">Longitud</label><input name="Ubicacion.Longitud" value="@Model.Ubicacion?.Longitud.ToString(inv)" class="form-control" required pattern="-?[0-9]+(\.[0-9]+)?" /></div>
                    </div>
                    @if (Model.Ubicacion is { } u && u.Latitud != 0)
                    {
                        <a class="btn btn-link px-0 mt-2" target="_blank" rel="noopener" href="https://www.openstreetmap.org/?mlat=@u.Latitud.ToString(inv)&mlon=@u.Longitud.ToString(inv)#map=17/@u.Latitud.ToString(inv)/@u.Longitud.ToString(inv)"><i class="ti ti-external-link me-1"></i>Ver en OpenStreetMap</a>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Horario de atención</h3></div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead><tr><th>Día</th><th>Abre</th><th>Cierra</th><th>Cerrado</th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < Dias.Cortos.Length; i++)
                        {
                            var h = horarios.FirstOrDefault(x => x.DiaSemana == Dias.Cortos[i]);
                            <tr>
                                <td>@nombres[i]<input type="hidden" name="dia" value="@Dias.Cortos[i]" /></td>
                                <td><input type="time" name="abre" value="@(h?.Abre.ToString("HH:mm") ?? "06:00")" class="form-control" /></td>
                                <td><input type="time" name="cierra" value="@(h?.Cierra.ToString("HH:mm") ?? "22:00")" class="form-control" /></td>
                                <td>
                                    <input type="hidden" name="feriado[@i]" value="false" />
                                    <input type="checkbox" class="form-check-input" name="feriado[@i]" value="true" checked="@(h?.EsFeriado == true)" />
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-secondary small">Los horarios de clases y los turnos del personal deben caer dentro de este horario.</div>
            </div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Guardar</button>
        <a class="btn btn-link" asp-action="Index">Volver</a>
    </div>
</form>
