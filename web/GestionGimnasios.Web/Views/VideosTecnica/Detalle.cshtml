@model VideoRevisionDto
@{
    ViewData["Title"] = Model.Ejercicio;
    ViewData["Pretitulo"] = $"Video de {Model.Socio}";
    var pendiente = Model.Estado == EstadosVideoTecnica.Pendiente;
}
@section Acciones {
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="ti ti-arrow-left me-1"></i>Volver a los videos</a>
}
<div class="row row-cards">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body p-0">
                <video class="w-100 d-block rounded-top" style="max-height: 480px" controls preload="metadata" src="@Url.Action("Archivo", new { id = Model.Id })">
                    Tu navegador no puede reproducir este video.
                </video>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Socio</dt><dd class="col-7">@Model.Socio</dd>
                    <dt class="col-5">Ejercicio</dt><dd class="col-7">@Model.Ejercicio · @Model.GrupoMuscular</dd>
                    <dt class="col-5">Enviado</dt><dd class="col-7">@Reloj.ALocal(Model.EnviadoEn).ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-5">Comentario del socio</dt><dd class="col-7">@(Model.Comentario ?? "Sin comentario")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Análisis preliminar</h3>
                <div class="card-actions"><span class="badge @ResultadosAnalisisVideo.Color(Model.ResultadoAnalisis)">@ResultadosAnalisisVideo.Etiqueta(Model.ResultadoAnalisis)</span></div>
            </div>
            <div class="card-body">
                @if (Model.TieneAnalisis)
                {
                    <dl class="row mb-2">
                        <dt class="col-5">Duración</dt>
                        <dd class="col-7">@(Model.DuracionSeg is null ? "Sin dato" : AnalizadorVideo.Duracion(Model.DuracionSeg.Value))</dd>
                        <dt class="col-5">Resolución</dt>
                        <dd class="col-7">
                            @if (Model.Ancho is null || Model.Alto is null)
                            {
                                <text>Sin dato</text>
                            }
                            else
                            {
                                <text>@Model.Ancho × @Model.Alto · @(Model.Alto > Model.Ancho ? "vertical" : "horizontal")</text>
                            }
                        </dd>
                    </dl>
                }
                @if (Model.AnalisisPreliminar is not null)
                {
                    <ul class="mb-2 ps-3">
                        @foreach (var linea in Model.AnalisisPreliminar.Split('\n'))
                        {
                            <li>@linea</li>
                        }
                    </ul>
                }
                else if (Model.TieneAnalisis)
                {
                    <p class="mb-2">La duración y la resolución permiten revisar el ejercicio.</p>
                }
                else
                {
                    <p class="text-secondary mb-2">No se pudieron leer los datos del archivo. Evalúa el video directamente.</p>
                }
                <p class="text-secondary small mb-0">Revisión automática del archivo: no evalúa la técnica, eso lo decides tú. Solo tú ves esta sección; el socio recibe únicamente tu devolución.</p>
            </div>
        </div>
        @if (pendiente)
        {
            <form method="post" asp-action="Revisar" asp-route-id="@Model.Id" class="card mt-3" data-confirmar="¿Enviar la devolución al socio? Después no se puede modificar.">
                <div class="card-header"><h3 class="card-title">Tu devolución</h3></div>
                <div class="card-body">
                    @if (Model.TieneAnalisis)
                    {
                        <div class="mb-3">
                            <label class="form-label required">Análisis preliminar</label>
                            <div class="form-selectgroup w-100">
                                <label class="form-selectgroup-item flex-fill">
                                    <input type="radio" name="AnalisisConfirmado" value="true" class="form-selectgroup-input" required />
                                    <span class="form-selectgroup-label"><i class="ti ti-check me-1"></i>Lo confirmo</span>
                                </label>
                                <label class="form-selectgroup-item flex-fill">
                                    <input type="radio" name="AnalisisConfirmado" value="false" class="form-selectgroup-input" />
                                    <span class="form-selectgroup-label"><i class="ti ti-pencil me-1"></i>Lo corrijo</span>
                                </label>
                            </div>
                            <textarea name="CorreccionAnalisis" class="form-control mt-2" rows="2" maxlength="500"
                                      placeholder="Si lo corriges, indica qué: por ejemplo, «se ve bien la postura aunque el video es corto»."></textarea>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label required">Valoración final</label>
                        <select name="Valoracion" class="form-select" required>
                            <option value="">Elige una opción</option>
                            @foreach (var v in ValoracionesTecnica.Todas)
                            {
                                <option value="@v">@ValoracionesTecnica.Etiqueta(v)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label required">Observación para el socio</label>
                        <textarea name="Observacion" class="form-control" rows="4" maxlength="1000" required></textarea>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button class="btn btn-primary">Enviar devolución</button>
                </div>
            </form>
        }
        else
        {
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">Devolución enviada</h3>
                    <div class="card-actions"><span class="badge bg-green-lt">@ValoracionesTecnica.Etiqueta(Model.Valoracion!)</span></div>
                </div>
                <div class="card-body">
                    <p>@Model.Observacion</p>
                    @if (Model.AnalisisConfirmado == true)
                    {
                        <p class="small mb-2"><i class="ti ti-check text-green me-1"></i>Confirmaste el análisis preliminar.</p>
                    }
                    else if (Model.AnalisisConfirmado == false)
                    {
                        <p class="small mb-2"><i class="ti ti-pencil text-orange me-1"></i>Corregiste el análisis preliminar: @Model.CorreccionAnalisis</p>
                    }
                    <div class="text-secondary small">Enviada el @Reloj.ALocal(Model.RevisadoEn!.Value).ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        }
    </div>
</div>
