@model UsuarioForm
@inject GestionGimnasios.Web.Infrastructure.UsuarioActual Actual
@{
    var usuario = ViewBag.Usuario as UsuarioDto;
    var editando = usuario is not null;
    var propio = usuario?.Id == Actual.Id;
    ViewData["Title"] = editando ? $"Editar · {usuario!.NombreCompleto}" : "Nuevo usuario";
    ViewData["Pretitulo"] = "Usuarios";
    var roles = (List<RolDto>)ViewBag.Roles;
    var ciObligatorio = !editando && roles.Any(r => r.Id == Model.RolId && r.Nombre == Roles.Cliente);
    var sucursales = (List<SucursalDto>)ViewBag.Sucursales;
    var cadenas = (List<CadenaDto>)ViewBag.Cadenas;
}
<form method="post" asp-action="@(editando ? "Editar" : "Crear")" asp-route-id="@usuario?.Id">
    <div class="row row-cards">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Datos personales</h3></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label required">Nombres</label><input asp-for="Nombres" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label required">Apellidos</label><input asp-for="Apellidos" class="form-control" required /></div>
                        <div class="col-md-6"><label class="form-label required">Correo</label><input asp-for="Email" type="email" class="form-control" required /></div>
                        <div class="col-md-6">
                            <label class="form-label @(editando ? "" : "required")">Contraseña</label>
                            <input asp-for="Password" type="password" class="form-control" minlength="6" required="@(!editando)" placeholder="@(editando ? "Dejar vacío para no cambiarla" : "")" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Ci" id="ci-label" class="form-label @(ciObligatorio ? "required" : "")">Carnet de identidad</label>
                            <input asp-for="Ci" class="form-control" required="@ciObligatorio" />
                        </div>
                        <div class="col-md-4"><label class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" /></div>
                        <div class="col-md-4">
                            <label class="form-label">Género</label>
                            <select asp-for="Genero" class="form-select">
                                <option value="">—</option>
                                <option>Masculino</option>
                                <option>Femenino</option>
                                <option>Otro</option>
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label">Fecha de nacimiento</label><input asp-for="FechaNacimiento" type="date" class="form-control" /></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Rol y alcance</h3></div>
                <div class="card-body">
                    @if (propio)
                    {
                        <div class="alert alert-info">No puedes cambiar tu propio rol, alcance ni estado.</div>
                        <input type="hidden" asp-for="RolId" />
                        <input type="hidden" asp-for="Activo" />
                    }
                    <div class="mb-3">
                        <label class="form-label required">Rol</label>
                        <select asp-for="RolId" class="form-select" disabled="@propio" required>
                            <option value="">Elegir…</option>
                            @foreach (var r in roles)
                            {
                                <option value="@r.Id" data-socio="@(r.Nombre == Roles.Cliente ? "true" : "false")">@r.Nombre (nivel @r.Nivel)</option>
                            }
                        </select>
                        <small class="form-hint">Solo aparecen roles de nivel menor al tuyo (RT-03).</small>
                    </div>
                    @if (Actual.EsSuperAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label">Cadena (solo para gerentes)</label>
                            <select asp-for="CadenaId" class="form-select" disabled="@propio">
                                <option value="">—</option>
                                @foreach (var c in cadenas)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Sucursal</label>
                        @if (Actual.SucursalFiltro is not null)
                        {
                            <input type="hidden" asp-for="SucursalId" />
                        }
                        <select asp-for="SucursalId" class="form-select" disabled="@(propio || Actual.SucursalFiltro is not null)">
                            <option value="">—</option>
                            @foreach (var s in sucursales)
                            {
                                <option value="@s.Id">@s.Nombre</option>
                            }
                        </select>
                        <small class="form-hint">Personal: sucursal donde trabaja. Cliente: sucursal habitual (crea su membresía en la cadena).</small>
                    </div>
                    <label class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" disabled="@propio" />
                        <span class="form-check-label">Cuenta activa</span>
                    </label>
                </div>
            </div>
            @if (usuario is not null && usuario.Membresias.Count > 0)
            {
                <div class="card mt-3">
                    <div class="card-header"><h3 class="card-title">Membresías</h3></div>
                    <ul class="list-group list-group-flush">
                        @foreach (var m in usuario.Membresias)
                        {
                            <li class="list-group-item">@m.Cadena <span class="text-secondary">@m.Sucursal</span></li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Guardar</button>
        <a class="btn btn-link" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    @if (!editando)
    {
        <script>
            const rol = document.getElementById('RolId');
            const ci = document.getElementById('Ci');
            const ciLabel = document.getElementById('ci-label');

            function actualizarCiObligatorio() {
                const obligatorio = rol.selectedOptions[0]?.dataset.socio === 'true';
                ci.required = obligatorio;
                ciLabel.classList.toggle('required', obligatorio);
            }

            rol.addEventListener('change', actualizarCiObligatorio);
            actualizarCiObligatorio();
        </script>
    }
}
