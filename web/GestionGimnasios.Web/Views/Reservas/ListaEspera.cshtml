@model List<EntradaEsperaDto>
@{
    ViewData["Title"] = "Lista de espera";
    ViewData["Pretitulo"] = "Operación";
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Socios esperando un cupo</h3><div class="card-actions text-secondary">Se respeta el orden de llegada</div></div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>#</th><th>Clase</th><th>Fecha</th><th>Socio</th><th>Sucursal</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var g in Model.GroupBy(e => new { e.HorarioActividadId, e.Fecha }))
            {
                var primero = true;
                foreach (var e in g.OrderBy(x => x.Posicion))
                {
                    <tr>
                        <td>@e.Posicion</td>
                        <td>@e.Actividad <span class="text-secondary small">@e.DiaSemana @e.Inicio.ToString("HH:mm")</span></td>
                        <td>@e.Fecha?.ToString("dd/MM/yyyy")</td>
                        <td>@e.Usuario</td>
                        <td class="text-secondary">@e.Sucursal</td>
                        <td><span class="badge @(e.Estado == EstadosEspera.Notificada ? "bg-yellow-lt" : "bg-blue-lt")">@e.Estado</span></td>
                        <td class="text-nowrap">
                            @if (primero)
                            {
                                <form method="post" asp-action="Asignar" asp-route-id="@e.Id" class="d-inline"><button class="btn btn-sm btn-success">Asignar cupo</button></form>
                            }
                            <form method="post" asp-action="QuitarDeEspera" asp-route-id="@e.Id" class="d-inline" data-confirmar="¿Quitar a @e.Usuario de la lista?"><button class="btn btn-sm btn-outline-danger"><i class="ti ti-x"></i></button></form>
                        </td>
                    </tr>
                    primero = false;
                }
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-secondary py-4">Nadie está en lista de espera.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
