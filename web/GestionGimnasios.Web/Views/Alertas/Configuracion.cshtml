@model ReglaInactividadDto
@{
    ViewData["Title"] = "Umbrales de inactividad";
    ViewData["Pretitulo"] = "Análisis";
    var resumen = (ResumenAlertasDto)ViewBag.Resumen;
}
@section Acciones {
    <form method="post" asp-action="Detectar">
        <button class="btn btn-primary"><i class="ti ti-refresh me-1"></i>Revisar socios ahora</button>
    </form>
}
<div class="row row-cards mb-3">
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body"><div class="subheader">Riesgo alto</div><div class="h1 mb-0 text-red">@resumen.Altas</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body"><div class="subheader">Aviso</div><div class="h1 mb-0 text-yellow">@resumen.Medias</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body"><div class="subheader">En seguimiento</div><div class="h1 mb-0">@resumen.EnSeguimiento</div></div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body"><div class="subheader">Cerradas en 30 días</div><div class="h1 mb-0 text-green">@resumen.CerradasUltimos30Dias</div></div></div>
    </div>
</div>
<div class="row row-cards">
    <div class="col-lg-6">
        <form method="post" class="card">
            <div class="card-header"><h3 class="card-title">Umbrales de tu cadena</h3></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label">Aviso desde</label>
                        <div class="input-group">
                            <input name="DiasAviso" type="number" min="1" max="180" class="form-control" value="@Model.DiasAviso" required />
                            <span class="input-group-text">días sin asistir</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label">Riesgo alto desde</label>
                        <div class="input-group">
                            <input name="DiasRiesgo" type="number" min="2" max="365" class="form-control" value="@Model.DiasRiesgo" required />
                            <span class="input-group-text">días sin asistir</span>
                        </div>
                    </div>
                </div>
                <label class="form-check mt-3">
                    <input type="hidden" name="SoloConPlanActivo" value="false" />
                    <input class="form-check-input" type="checkbox" name="SoloConPlanActivo" value="true" checked="@Model.SoloConPlanActivo" />
                    <span class="form-check-label">Revisar solo a socios con un plan activo</span>
                </label>
                <label class="form-check">
                    <input type="hidden" name="Activa" value="false" />
                    <input class="form-check-input" type="checkbox" name="Activa" value="true" checked="@Model.Activa" />
                    <span class="form-check-label">Detección activa</span>
                </label>
            </div>
            <div class="card-footer d-flex align-items-center">
                <span class="text-secondary small">@(Model.ActualizadaEn is DateTime a ? $"Última modificación: {Reloj.ALocal(a):dd/MM/yyyy HH:mm}" : "Valores por defecto: todavía no se guardaron.")</span>
                <button class="btn btn-primary ms-auto">Guardar umbrales</button>
            </div>
        </form>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Cómo funciona</h3></div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>Cada día a las 9:00 el sistema revisa a los socios con membresía activa en tu cadena.</li>
                    <li>Cuenta los días desde su último ingreso o entrenamiento en una de tus sucursales. Si nunca asistió, desde que se inscribió.</li>
                    <li>Al superar el aviso se abre una alerta. Si sigue sin venir, pasa a riesgo alto.</li>
                    <li>Cada socio tiene una sola alerta abierta: la revisión la actualiza y la cierra sola cuando vuelve a asistir.</li>
                    <li>El entrenador y la recepción solo ven las alertas de su sucursal, y registran el contacto en la alerta.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
