@inject GestionGimnasios.Web.Infrastructure.UsuarioActual Usuario
@inject GestionGimnasios.Web.Services.NotificacionesService Notificaciones
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var opciones = Menu.Opciones.Where(o => Usuario.Nivel >= o.NivelMinimo && (!o.SoloSuperAdmin || Usuario.EsSuperAdmin)).ToList();
    var sinLeer = Usuario.Autenticado ? await Notificaciones.SinLeerAsync() : 0;
    var alcance = Usuario.EsSuperAdmin ? "Todas las cadenas" : User.FindFirst("alcance")?.Value;
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Gestión Gimnasios</title>
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tabler-icons/tabler-icons.min.css" asp-append-version="true" />
    <script>
        // Tema guardado por el usuario (claro u oscuro); se aplica antes de pintar para evitar el parpadeo.
        try { var tema = localStorage.getItem('tema'); if (tema) document.documentElement.setAttribute('data-bs-theme', tema); } catch (e) { }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
<div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg d-print-none" data-bs-theme="dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-lateral" aria-controls="menu-lateral" aria-expanded="false" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand navbar-brand-autodark" asp-controller="Home" asp-action="Index">
                <i class="ti ti-barbell me-2"></i>Gestión Gimnasios
            </a>
            <div class="collapse navbar-collapse" id="menu-lateral">
                <ul class="navbar-nav pt-lg-3">
                    @foreach (var grupo in opciones.GroupBy(o => o.Grupo))
                    {
                        if (grupo.Key is not null)
                        {
                            <li class="nav-item mt-3"><span class="nav-link text-uppercase small text-secondary py-1">@grupo.Key</span></li>
                        }
                        foreach (var o in grupo)
                        {
                            var activo = o.Controlador == controlador && (o.Accion == accion || (o.Accion == "Index" && opciones.All(x => x.Controlador != controlador || x.Accion != accion)));
                            <li class="nav-item @(activo ? "active" : "")">
                                <a class="nav-link" asp-controller="@o.Controlador" asp-action="@o.Accion">
                                    <span class="nav-link-icon"><i class="ti @o.Icono"></i></span>
                                    <span class="nav-link-title">@o.Titulo</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </aside>

    <div class="page-wrapper">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl">
                <div class="navbar-nav flex-row order-md-last ms-auto">
                    <button type="button" class="nav-link px-2 btn btn-link" data-cambiar-tema title="Cambiar tema claro u oscuro" aria-label="Cambiar tema claro u oscuro">
                        <i class="ti ti-sun fs-2 icono-tema-oscuro"></i>
                        <i class="ti ti-moon fs-2 icono-tema-claro"></i>
                    </button>
                    <a class="nav-link px-2 position-relative" asp-controller="Notificaciones" asp-action="Index" title="Notificaciones">
                        <i class="ti ti-bell fs-2"></i>
                        @if (sinLeer > 0)
                        {
                            <span class="badge bg-red badge-notification">@sinLeer</span>
                        }
                    </a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex lh-1 p-0 px-2" data-bs-toggle="dropdown" aria-label="Menú de usuario">
                            <span class="avatar avatar-sm bg-blue-lt">@(Usuario.Nombre.Length > 0 ? Usuario.Nombre[..1].ToUpper() : "?")</span>
                            <div class="d-none d-xl-block ps-2">
                                <div>@Usuario.Nombre</div>
                                <div class="mt-1 small text-secondary">@Usuario.Rol @(alcance is null ? "" : $"· {alcance}")</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            <a class="dropdown-item" asp-controller="Perfil" asp-action="Index"><i class="ti ti-user me-2"></i>Mi perfil</a>
                            <div class="dropdown-divider"></div>
                            <form method="post" asp-controller="Cuenta" asp-action="Salir">
                                <button type="submit" class="dropdown-item"><i class="ti ti-logout me-2"></i>Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="page-header d-print-none">
            <div class="container-xl">
                <div class="row g-2 align-items-center">
                    <div class="col">
                        @if (ViewData["Pretitulo"] is string pre)
                        {
                            <div class="page-pretitle">@pre</div>
                        }
                        <h2 class="page-title">@ViewData["Title"]</h2>
                    </div>
                    <div class="col-12 col-md-auto ms-md-auto d-flex flex-wrap gap-2">
                        @await RenderSectionAsync("Acciones", required: false)
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                <partial name="_Mensajes" />
                @RenderBody()
            </div>
        </div>

        <footer class="footer footer-transparent d-print-none">
            <div class="container-xl text-secondary small">Gestión Gimnasios · Proyecto de Sistemas III · Universidad del Valle</div>
        </footer>
    </div>
</div>
<script src="~/lib/tabler/js/tabler.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
