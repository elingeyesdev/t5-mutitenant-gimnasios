@model List<CanjeDto>
@{
    ViewData["Title"] = "Canjes de beneficios";
    ViewData["Pretitulo"] = "Operación";
    var encontrado = ViewBag.Encontrado as CanjeDto;
    var estado = (string?)ViewBag.Estado;
}
<div class="row row-cards">
    <div class="col-lg-4">
        <form method="get" class="card">
            <div class="card-header"><h3 class="card-title">Validar comprobante</h3></div>
            <div class="card-body">
                <label class="form-label">Código que muestra el socio</label>
                <div class="input-group">
                    <input name="codigo" class="form-control text-uppercase" value="@ViewBag.Codigo" maxlength="12" placeholder="Por ejemplo: 7F3A91C2" autofocus required />
                    <button class="btn btn-primary"><i class="ti ti-search"></i></button>
                </div>
            </div>
        </form>
        @if (encontrado is not null)
        {
            var entregado = encontrado.Estado == EstadosCanje.Entregado;
            <div class="card mt-3">
                <div class="card-body">
                    <div class="d-flex align-items-start">
                        <div>
                            <div class="text-secondary small">@TiposBeneficio.Etiqueta(encontrado.Tipo)</div>
                            <h3 class="card-title mb-1">@encontrado.Beneficio</h3>
                        </div>
                        <span class="badge ms-auto @(entregado ? "bg-secondary-lt" : "bg-green-lt")">@(entregado ? "Ya entregado" : "Pendiente")</span>
                    </div>
                    <dl class="row small mb-0 mt-2">
                        <dt class="col-5">Socio</dt><dd class="col-7">@encontrado.Socio</dd>
                        <dt class="col-5">Código</dt><dd class="col-7 font-monospace">@encontrado.Codigo</dd>
                        <dt class="col-5">Canjeado</dt><dd class="col-7">@Reloj.ALocal(encontrado.CanjeadoEn).ToString("dd/MM/yyyy HH:mm")</dd>
                        @if (encontrado.EntregadoEn is DateTime e)
                        {
                            <dt class="col-5">Entregado</dt><dd class="col-7">@Reloj.ALocal(e).ToString("dd/MM/yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
                @if (!entregado)
                {
                    <div class="card-footer">
                        <form method="post" asp-action="Entregar">
                            <input type="hidden" name="codigo" value="@encontrado.Codigo" />
                            <button class="btn btn-success w-100"><i class="ti ti-check me-1"></i>Entregar beneficio</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Últimos canjes</h3>
                <div class="card-actions">
                    <form method="get" class="d-flex gap-2">
                        <select name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Todos</option>
                            <option value="@EstadosCanje.Emitido" selected="@(estado == EstadosCanje.Emitido)">Pendientes</option>
                            <option value="@EstadosCanje.Entregado" selected="@(estado == EstadosCanje.Entregado)">Entregados</option>
                        </select>
                    </form>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead><tr><th>Código</th><th>Beneficio</th><th>Socio</th><th>Canjeado</th><th>Estado</th></tr></thead>
                    <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="font-monospace"><a asp-action="Canjes" asp-route-codigo="@c.Codigo">@c.Codigo</a></td>
                            <td>@c.Beneficio</td>
                            <td>@c.Socio</td>
                            <td class="text-secondary">@Reloj.ALocal(c.CanjeadoEn).ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @(c.Estado == EstadosCanje.Entregado ? "bg-secondary-lt" : "bg-green-lt")">@(c.Estado == EstadosCanje.Entregado ? "Entregado" : "Pendiente")</span></td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-secondary py-4">Todavía no hay canjes.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
