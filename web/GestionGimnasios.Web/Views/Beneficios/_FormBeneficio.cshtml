@model BeneficioDto?
@inject GestionGimnasios.Web.Infrastructure.UsuarioActual Actual
@{
    var cadenas = (List<CadenaDto>)ViewData["Cadenas"]!;
    var hoy = Reloj.Hoy;
}
<form method="post" asp-action="Guardar" asp-route-id="@Model?.Id">
    @if (Actual.EsSuperAdmin && Model is null)
    {
        <div class="mb-2">
            <label class="form-label">Cadena</label>
            <select name="CadenaId" class="form-select" required>
                @foreach (var c in cadenas)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
        </div>
    }
    <div class="mb-2"><label class="form-label">Nombre</label><input name="Nombre" class="form-control" value="@Model?.Nombre" maxlength="150" required /></div>
    <div class="row g-2 mb-2">
        <div class="col-6">
            <label class="form-label">Tipo</label>
            <select name="Tipo" class="form-select">
                @foreach (var t in TiposBeneficio.Todos)
                {
                    <option value="@t" selected="@(Model?.Tipo == t)">@TiposBeneficio.Etiqueta(t)</option>
                }
            </select>
        </div>
        <div class="col-6"><label class="form-label">Canjes por socio</label><input name="LimitePorSocio" type="number" min="1" class="form-control" value="@(Model?.LimitePorSocio ?? 1)" required /></div>
    </div>
    <div class="mb-2"><label class="form-label">Descripción</label><input name="Descripcion" class="form-control" value="@Model?.Descripcion" /></div>
    <div class="mb-2"><label class="form-label">Condiciones de uso</label><input name="Condiciones" class="form-control" value="@Model?.Condiciones" placeholder="Por ejemplo: válido en bebidas de la cafetería" /></div>
    <div class="row g-2 mb-2">
        <div class="col-6"><label class="form-label">Desde</label><input name="VigenteDesde" type="date" class="form-control" value="@((Model?.VigenteDesde ?? hoy).ToString("yyyy-MM-dd"))" required /></div>
        <div class="col-6"><label class="form-label">Hasta</label><input name="VigenteHasta" type="date" class="form-control" value="@((Model?.VigenteHasta ?? hoy.AddMonths(1)).ToString("yyyy-MM-dd"))" required /></div>
    </div>
    <div class="row g-2 mb-2">
        <div class="col-6"><label class="form-label">Cupos totales</label><input name="CuposTotales" type="number" min="1" class="form-control" value="@Model?.CuposTotales" placeholder="Sin límite" /></div>
        <div class="col-6"><label class="form-label">Ingresos en 30 días</label><input name="AsistenciasMinimas" type="number" min="0" class="form-control" value="@(Model?.AsistenciasMinimas ?? 0)" /></div>
    </div>
    <label class="form-check mb-3">
        <input type="hidden" name="RequierePlanActivo" value="false" />
        <input class="form-check-input" type="checkbox" name="RequierePlanActivo" value="true" checked="@(Model?.RequierePlanActivo ?? true)" />
        <span class="form-check-label">Requiere un plan activo en la cadena</span>
    </label>
    <button class="btn btn-primary w-100">@(Model is null ? "Crear beneficio" : "Guardar cambios")</button>
</form>
